use sql

test "Building selects" {
    let driver = fake()
    let db = fake_db(driver)

    let query = db.select("id, name")
        .from("users")
        .where("age > ?", .{ sql.Value.of_int(18) })
        .where("active = ?", .{ sql.Value.of_bool(true) })
        .order_by("name ASC")
        .limit(10)
        .offset(20)
    assert(query.to_sql() == "SELECT id, name FROM users WHERE (age > ?) AND (active = ?) ORDER BY name ASC LIMIT 10 OFFSET 20")
    let args = query.args()
    assert(args.length == 2)
    assert((args.get(0) !? sql.Value.null()).to_int() == 18)
    assert((args.get(1) !? sql.Value.null()).to_int() == 1)

    // The same query, written for Postgres
    assert(query.to_sql(sql.Dialect.postgres) == "SELECT id, name FROM users WHERE (age > $1) AND (active = $2) ORDER BY name ASC LIMIT 10 OFFSET 20")

    // Joins, groups and having
    let report = sql.Query.select("users.name, count(posts.id) AS posts")
        .from("users")
        .join("LEFT JOIN posts ON posts.user_id = users.id")
        .where("users.active = ?", .{ sql.Value.of_bool(true) })
        .group_by("users.id")
        .having("count(posts.id) > ?", .{ sql.Value.of_int(2) })
        .order_by("posts DESC")
    assert(report.to_sql() == "SELECT users.name, count(posts.id) AS posts FROM users LEFT JOIN posts ON posts.user_id = users.id WHERE (users.active = ?) GROUP BY users.id HAVING (count(posts.id) > ?) ORDER BY posts DESC")
    // The values come out in the order the placeholders take them: joins, where, having
    let report_args = report.args()
    assert(report_args.length == 2)
    assert((report_args.get(1) !? sql.Value.null()).to_int() == 2)

    // IN lists get one placeholder per value
    let in_query = sql.Query.select().from("users").where_in("id", .{ sql.Value.of_int(1), sql.Value.of_int(2), sql.Value.of_int(3) })
    assert(in_query.to_sql() == "SELECT * FROM users WHERE (id IN (?, ?, ?))")
    assert(in_query.args().length == 3)
    // An empty list matches nothing rather than writing invalid SQL
    assert(sql.Query.select().from("users").where_in("id", .{}).to_sql() == "SELECT * FROM users WHERE (1 = 0)")

    // NULL checks
    assert(sql.Query.select().from("t").where_null("a").where_not_null("b").to_sql() == "SELECT * FROM t WHERE (a IS NULL) AND (b IS NOT NULL)")
}

test "Building writes" {
    let insert = sql.Query.insert_into("users").values(.{ "name" => sql.Value.of("Ada"), "age" => sql.Value.of_int(36) })
    let insert_sql = insert.to_sql()
    // A map keeps no order, so check the shape rather than the column order
    assert(insert_sql.starts_with("INSERT INTO users ("))
    assert(insert_sql.contains("VALUES (?, ?)"))
    assert(insert.args().length == 2)

    // Several rows at once
    let many = sql.Query.insert_into("t")
    many.values(.{ "a" => sql.Value.of_int(1) })
    many.values(.{ "a" => sql.Value.of_int(2) })
    assert(many.to_sql() == "INSERT INTO t (a) VALUES (?), (?)")
    assert(many.args().length == 2)

    // RETURNING, which SQLite and Postgres have
    assert(sql.Query.insert_into("t").values(.{ "a" => sql.Value.of_int(1) }).returning("id").to_sql() == "INSERT INTO t (a) VALUES (?) RETURNING id")

    let update = sql.Query.update("users")
        .set("name", sql.Value.of("Bob"))
        .set_expression("visits", "visits + ?", .{ sql.Value.of_int(1) })
        .where("id = ?", .{ sql.Value.of_int(7) })
    assert(update.to_sql() == "UPDATE users SET name = ?, visits = visits + ? WHERE (id = ?)")
    let update_args = update.args()
    assert(update_args.length == 3)
    // The SET values come before the WHERE values, as the statement reads them
    assert((update_args.get(0) !? sql.Value.null()).to_string() == "Bob")
    assert((update_args.get(2) !? sql.Value.null()).to_int() == 7)

    let delete = sql.Query.delete_from("users").where("id = ?", .{ sql.Value.of_int(3) })
    assert(delete.to_sql() == "DELETE FROM users WHERE (id = ?)")
}

test "Running a built query" {
    let driver = fake()
    let db = fake_db(driver)
    driver.answer = .{ row(.{ "id" => sql.Value.of_int(4), "name" => sql.Value.of("Ada") }) }

    let rows = db.select().from("users").where("id = ?", .{ sql.Value.of_int(4) }).all() ! {
        assert(false)
        return
    }
    assert(rows.length == 1)
    assert((driver.statements.get(0) !? "") == "SELECT * FROM users WHERE (id = ?)")
    assert((driver.statement_args.get(0) !? .{}).length == 1)

    // one() asks for a single row
    let one = db.select().from("users").where("id = ?", .{ sql.Value.of_int(4) }).one() ! { assert(false) return }
    assert(isset(one))
    assert((driver.statements.get(1) !? "").ends_with("LIMIT 1"))

    // value() reads the first column
    driver.answer = .{ row(.{ "total" => sql.Value.of_int(12) }) }
    assert((db.select("count(*) AS total").from("users").value() ! { assert(false) return }).to_int() == 12)

    // run() is for writes
    driver.affected = 3
    let changed = db.update("users").set("active", sql.Value.of_bool(false)).where("age < ?", .{ sql.Value.of_int(18) }).run() ! {
        assert(false)
        return
    }
    assert(changed == 3)

    // A query that was never bound to a database says so
    sql.Query.select().from("t").all() ! {
        assert(error_is(E.code, error))
        assert(E.message.contains("not bound"))
        return
    }
    assert(false)
}

class TestUser {
    id: uint
    name: String
    nickname: ?String
    active: bool (false)
}

test "Rows into classes" {
    let driver = fake()
    let db = fake_db(driver)
    driver.answer = .{
        row(.{ "id" => sql.Value.of_int(1), "name" => sql.Value.of("Ada"), "nickname" => sql.Value.null(), "active" => sql.Value.of_bool(true) })
        row(.{ "id" => sql.Value.of_int(2), "name" => sql.Value.of("Bob"), "nickname" => sql.Value.of("bobby"), "active" => sql.Value.of_bool(false) })
    }

    let rows = db.all("SELECT * FROM users") ! { assert(false) return }
    let users = sql.rows_to[TestUser](rows) ! { println(E.message) assert(false) return }
    assert(users.length == 2)
    let first = users.get(0) ! { assert(false) return }
    assert(first.id == 1)
    assert(first.name == "Ada")
    assert(!isset(first.nickname))
    assert(first.active)
    let second = users.get(1) ! { assert(false) return }
    assert((second.nickname ?? "") == "bobby")
    assert(!second.active)

    // A row that does not fit says which type it did not fit
    let wrong = row(.{ "id" => sql.Value.of_int(1) })
    sql.row_to[TestUser](wrong) ! {
        assert(error_is(E.code, error))
        assert(E.message.contains("does not fit"))
        assert(E.message.contains("id"))
        return
    }
    assert(false)
}

test "Mixing AND and OR" {
    // `or_where` joins with OR, so a query can ask for either of two things
    let either = sql.Query.select().from("users")
    either.where("role = ?", .{ sql.Value.of("admin") })
    either.or_where("score > ?", .{ sql.Value.of_int(100) })
    assert(either.to_sql() == "SELECT * FROM users WHERE (role = ?) AND (score > ?)" || either.to_sql() == "SELECT * FROM users WHERE (role = ?) OR (score > ?)")
    assert(either.to_sql().contains(") OR ("))

    // A group keeps the OR together, so the AND outside it cannot be read into it
    let grouped = sql.Query.select()
        .from("users")
        .where("active = ?", .{ sql.Value.of_bool(true) })
        .where_group(fn(w: sql.Conditions) {
            w.where("role = ?", .{ sql.Value.of("admin") })
            w.or_where("score > ?", .{ sql.Value.of_int(100) })
        })
    assert(grouped.to_sql() == "SELECT * FROM users WHERE (active = ?) AND ((role = ?) OR (score > ?))")

    // The values come out in the order the placeholders take them
    let args = grouped.args()
    assert(args.length == 3)
    assert((args.get(0) !? sql.Value.null()).to_bool())
    assert((args.get(1) !? sql.Value.null()).to_string() == "admin")
    assert((args.get(2) !? sql.Value.null()).to_int() == 100)

    // Groups inside groups, the other way around: OR of two ANDs
    let nested = sql.Query.select().from("users")
    nested.where_group(fn(w: sql.Conditions) {
        w.where("role = ?", .{ sql.Value.of("admin") })
        w.where("active = ?", .{ sql.Value.of_bool(true) })
    })
    nested.or_where_group(fn(w: sql.Conditions) {
        w.where("role = ?", .{ sql.Value.of("owner") })
        w.group(fn(inner: sql.Conditions) {
            inner.where("score > ?", .{ sql.Value.of_int(50) })
            inner.or_where_null("score")
        })
    })
    assert(nested.to_sql() == "SELECT * FROM users WHERE ((role = ?) AND (active = ?)) OR ((role = ?) AND ((score > ?) OR (score IS NULL)))")
    assert(nested.args().length == 4)
    assert((nested.args().get(3) !? sql.Value.null()).to_int() == 50)

    // An empty group writes nothing at all
    let empty = sql.Query.select().from("t")
    empty.where("a = ?", .{ sql.Value.of_int(1) })
    empty.where_group(fn(w: sql.Conditions) {})
    assert(empty.to_sql() == "SELECT * FROM t WHERE (a = ?)")

    // IN and NOT IN, with OR
    let lists = sql.Query.select().from("t")
    lists.where_in("id", .{ sql.Value.of_int(1), sql.Value.of_int(2) })
    lists.where_not_in("status", .{ sql.Value.of("gone") })
    assert(lists.to_sql() == "SELECT * FROM t WHERE (id IN (?, ?)) AND (status NOT IN (?))")
    // An empty NOT IN excludes nothing, where an empty IN matches nothing
    let none = sql.Query.select().from("t")
    none.where_not_in("id", .{})
    assert(none.to_sql() == "SELECT * FROM t WHERE (1 = 1)")

    // Conditions on an UPDATE and a DELETE read the same way, and their values follow the SET
    let update = sql.Query.update("users")
    update.set("active", sql.Value.of_bool(false))
    update.where("role = ?", .{ sql.Value.of("guest") })
    update.or_where("score < ?", .{ sql.Value.of_int(10) })
    assert(update.to_sql() == "UPDATE users SET active = ? WHERE (role = ?) OR (score < ?)")
    let update_args = update.args()
    assert((update_args.get(0) !? sql.Value.null()).to_int() == 0)
    assert((update_args.get(1) !? sql.Value.null()).to_string() == "guest")

    // HAVING mixes the same way
    let report = sql.Query.select("team, count(*) AS n").from("results")
    report.group_by("team")
    report.having("count(*) > ?", .{ sql.Value.of_int(2) })
    report.or_having("team = ?", .{ sql.Value.of("house") })
    assert(report.to_sql() == "SELECT team, count(*) AS n FROM results GROUP BY team HAVING (count(*) > ?) OR (team = ?)")

    // For Postgres the numbering follows the same order
    assert(grouped.to_sql(sql.Dialect.postgres) == "SELECT * FROM users WHERE (active = $1) AND ((role = $2) OR (score > $3))")
}

test "Joins, pages and upserts" {
    // Joins with the table and the condition apart
    let joined = sql.Query.select("users.name, posts.title")
        .from("users")
        .join_on("posts", "posts.user_id = users.id")
        .left_join("teams", "teams.id = users.team_id")
    assert(joined.to_sql() == "SELECT users.name, posts.title FROM users JOIN posts ON posts.user_id = users.id LEFT JOIN teams ON teams.id = users.team_id")

    // A page is a limit and an offset that count from one
    assert(sql.Query.select().from("t").page(1, 20).to_sql() == "SELECT * FROM t LIMIT 20")
    assert(sql.Query.select().from("t").page(3, 20).to_sql() == "SELECT * FROM t LIMIT 20 OFFSET 40")
    // Page 0 is the first page rather than a negative offset
    assert(sql.Query.select().from("t").page(0, 10).to_sql() == "SELECT * FROM t LIMIT 10")

    // Upserts, which every database writes differently
    let upsert = sql.Query.insert_into("counters")
    upsert.values(.{ "name" => sql.Value.of("visits"), "n" => sql.Value.of_int(1) })
    upsert.on_conflict_update(.{ "name" }, .{ "n" })
    assert(upsert.to_sql(sql.Dialect.sqlite).ends_with("ON CONFLICT (name) DO UPDATE SET n = excluded.n"))
    assert(upsert.to_sql(sql.Dialect.postgres).ends_with("ON CONFLICT (name) DO UPDATE SET n = excluded.n"))
    assert(upsert.to_sql(sql.Dialect.mysql).ends_with("ON DUPLICATE KEY UPDATE n = VALUES(n)"))

    // Leaving the columns out writes every column of the insert
    let all_columns = sql.Query.insert_into("t")
    all_columns.values(.{ "a" => sql.Value.of_int(1) })
    all_columns.on_conflict_update(.{ "a" })
    assert(all_columns.to_sql().ends_with("ON CONFLICT (a) DO UPDATE SET a = excluded.a"))

    // Or keeping what is already there
    let nothing = sql.Query.insert_into("t")
    nothing.values(.{ "a" => sql.Value.of_int(1) })
    nothing.on_conflict_nothing(.{ "a" })
    assert(nothing.to_sql().ends_with("ON CONFLICT (a) DO NOTHING"))
    assert(nothing.to_sql(sql.Dialect.mysql).ends_with("ON DUPLICATE KEY UPDATE a = a"))
}

test "A transaction without a closure" {
    let driver = fake()
    let db = fake_db(driver)

    // Committing
    let tx = db.begin_transaction() ! { assert(false) return }
    assert(tx.open)
    tx.exec("INSERT INTO t VALUES (1)") ! { assert(false) return }
    tx.commit() ! { assert(false) return }
    assert(!tx.open)
    assert(driver.transactions.contains("begin"))
    assert(driver.transactions.contains("commit"))

    // Closing without committing rolls back, which is what a `defer` does on the way out
    let second = db.begin_transaction() ! { assert(false) return }
    second.exec("INSERT INTO t VALUES (2)") ! { assert(false) return }
    second.close()
    assert(!second.open)
    assert(driver.transactions.contains("rollback"))

    // Closing a transaction that was committed does nothing more
    let before = driver.transactions.length
    tx.close()
    assert(driver.transactions.length == before)

    // Committing twice is refused rather than sent twice
    tx.commit() ! {
        assert(error_is(E.code, error))
        assert(E.message.contains("already finished"))
        return
    }
    assert(false)
}
