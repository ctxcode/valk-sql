use sql

test "Running statements" {
    let driver = fake()
    let db = fake_db(driver)
    assert(db.dialect == sql.Dialect.sqlite)

    // Values travel next to the statement, never inside it
    let changed = db.exec("INSERT INTO users (name, age) VALUES (:name, :age)", .{ "name" => "Ada", "age" => 36 }) ! {
        assert(false)
        return
    }
    assert(changed == 1)
    assert((driver.statements.get(0) !? "") == "INSERT INTO users (name, age) VALUES (?, ?)")
    let args = driver.statement_args.get(0) !? .{}
    assert(args.length == 2)
    assert((args.get(0) !? sql.Value.null()).to_string() == "Ada")
    assert((args.get(1) !? sql.Value.null()).to_int() == 36)

    // Rows come back as maps of values
    driver.answer = .{
        row(.{ "id" => sql.Value.of_int(1), "name" => sql.Value.of("Ada") })
        row(.{ "id" => sql.Value.of_int(2), "name" => sql.Value.of("Bob") })
    }
    let rows = db.all("SELECT * FROM users") ! { assert(false) return }
    assert(rows.length == 2)
    assert(((rows.get(1) !? .{}).get("name") !? sql.Value.null()).to_string() == "Bob")

    // One row, or none
    let first = db.one("SELECT * FROM users") ! { assert(false) return }
    assert(isset(first))
    if isset(first) : assert((first.get("id") !? sql.Value.null()).to_int() == 1)
    driver.answer = .{}
    assert(!isset(db.one("SELECT * FROM users") ! { assert(false) return }))

    // One value
    driver.answer = .{ row(.{ "count" => sql.Value.of_int(7) }) }
    assert((db.value("SELECT count(*) FROM users") ! { assert(false) return }).to_int() == 7)
    driver.answer = .{}
    assert((db.value("SELECT count(*) FROM users") ! { assert(false) return }).is_null())

    assert(db.ping())
    db.close()
    assert(driver.closed)
}

test "Placeholders are written per database" {
    // SQLite and MySQL take `?`, Postgres numbers them
    let values: Map[sql.Value] = .{ "a" => 1, "b" => 2 }
    let lite, _ = sql.named("SELECT * FROM t WHERE a = :a AND b = :b", values) ! { assert(false) return }
    assert(lite == "SELECT * FROM t WHERE a = ? AND b = ?")
    let my, _ = sql.named("SELECT * FROM t WHERE a = :a", values, sql.Dialect.mysql) ! { assert(false) return }
    assert(my == "SELECT * FROM t WHERE a = ?")
    let pg, _ = sql.named("SELECT * FROM t WHERE a = :a AND b = :b", values, sql.Dialect.postgres) ! { assert(false) return }
    assert(pg == "SELECT * FROM t WHERE a = $1 AND b = $2")

    // A `?` of the statement's own, such as the Postgres JSON operator, stays as it is
    let json, _ = sql.named("SELECT * FROM t WHERE data ? 'key' AND a = :a", values, sql.Dialect.postgres) ! { assert(false) return }
    assert(json == "SELECT * FROM t WHERE data ? 'key' AND a = $1")

    // And a statement run through a Postgres database comes out numbered
    let driver = fake()
    driver.dialect_kind = sql.Dialect.postgres
    let db = fake_db(driver)
    db.exec("DELETE FROM t WHERE a = :a AND b = :b", values) ! { assert(false) return }
    assert((driver.statements.get(0) !? "") == "DELETE FROM t WHERE a = $1 AND b = $2")
}

test "Transactions" {
    let driver = fake()
    let db = fake_db(driver)

    // A transaction that returns commits
    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("UPDATE accounts SET balance = balance - 10") !>
    }) ! { assert(false) return }
    assert(driver.transactions.length == 2)
    assert((driver.transactions.get(0) !? "") == "begin")
    assert((driver.transactions.get(1) !? "") == "commit")

    // One that throws rolls back, and the error reaches the caller
    driver.fail_with = "unique constraint"
    db.transaction(fn(tx: sql.Db) !sql.Error {
        tx.exec("INSERT INTO accounts VALUES (1)") !>
    }) ! {
        assert(error_is(E.code, constraint))
        assert((driver.transactions.get(3) !? "") == "rollback")
        assert(driver.transactions.length == 4)
        return
    }
    assert(false)
}

test "Values" {
    assert(sql.Value.of("text").to_string() == "text")
    assert(sql.Value.of_int(-3).to_int() == -3)
    assert(sql.Value.of_int(-3).to_uint() == 0)
    assert(sql.Value.of_int(42).to_string() == "42")
    assert(sql.Value.of_float(1.5).to_float() == 1.5)
    assert(sql.Value.of_bool(true).to_int() == 1)
    assert(sql.Value.of_bool(false).to_bool() == false)
    assert(sql.Value.null().is_null())
    assert(!isset(sql.Value.null().to_string_or_null()))
    assert(sql.Value.of_blob("\x00\x01").is_blob())
    assert(sql.Value.of_blob("\x00\x01").to_string().length == 2)
    assert(sql.Value.of("{\"a\":1}").to_json()["a"].int == 1)

    // Ordinary valk values convert
    assert(sql.convert(7).to_int() == 7)
    assert(sql.convert("x").to_string() == "x")
    assert(sql.convert(true).to_bool())
    assert(sql.convert(1.25).to_float() == 1.25)
    let missing: ?String = null
    assert(sql.convert(missing).is_null())
}

test "Named placeholders" {
    let statement, args = sql.named("SELECT * FROM t WHERE a = :a AND b = :b OR a = :a", .{ "a" => 1, "b" => "x", "unused" => sql.Value.null() }) ! {
        println(E.message)
        assert(false)
        return
    }
    assert(statement == "SELECT * FROM t WHERE a = ? AND b = ? OR a = ?")
    assert(args.length == 3 && (args.get(2) !? sql.Value.null()).to_int() == 1)

    // Quoted text, casts and times are not placeholders
    let quoted, none = sql.named("SELECT ':a', \"x:y\", '12:30', v::int, :v::text FROM t", .{ "v" => "7" }) ! { assert(false) return }
    assert(quoted == "SELECT ':a', \"x:y\", '12:30', v::int, ?::text FROM t")
    assert(none.length == 1)

    let missing = ""
    sql.named("SELECT :nope", .{}) ! { missing = E.message }
    assert(missing == "No value for the placeholder ':nope'")

    // An array becomes a list, however long; an empty one is NULL
    let ids = Array[int]{}
    while ids.length < 1000 : ids.append(ids.length.to(int))
    let listed, list_args = sql.named("SELECT * FROM t WHERE id IN (:ids)", .{ "ids" => ids }, sql.Dialect.postgres) ! { assert(false) return }
    assert(list_args.length == 1000)
    assert(listed.starts_with("SELECT * FROM t WHERE id IN ($1, $2, $3, ") && listed.ends_with(", $1000)"))
    let no_ids = Array[int]{}
    let empty, empty_args = sql.named("SELECT * FROM t WHERE id IN (:ids)", .{ "ids" => no_ids }) ! { assert(false) return }
    assert(empty == "SELECT * FROM t WHERE id IN (NULL)" && empty_args.length == 0)

    // Through a Db, for every kind of call
    let driver = fake()
    driver.dialect_kind = sql.Dialect.postgres
    let db = fake_db(driver)
    db.exec("UPDATE users SET name = :name WHERE id = :id", .{ "id" => 3, "name" => "Ada" }) ! { assert(false) return }
    assert((driver.statements.get(0) !? "") == "UPDATE users SET name = $1 WHERE id = $2")
    let sent = driver.statement_args.get(0) !? .{}
    assert((sent.get(0) !? sql.Value.null()).to_string() == "Ada" && (sent.get(1) !? sql.Value.null()).to_int() == 3)
    db.all("SELECT * FROM users WHERE id IN (:ids)", .{ "ids" => Array[int]{ 1, 2 } }) ! { assert(false) return }
    assert((driver.statements.get(1) !? "") == "SELECT * FROM users WHERE id IN ($1, $2)")
}
