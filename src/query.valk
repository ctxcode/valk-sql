// What a Query is building
value CONFLICT_NONE (0)
value CONFLICT_UPDATE (1)
value CONFLICT_NOTHING (2)

value QUERY_SELECT (0)
value QUERY_INSERT (1)
value QUERY_UPDATE (2)
value QUERY_DELETE (3)

/// A statement built from its parts, with the values kept apart from the text.
///
/// Conditions are written with `?` placeholders and their values passed next to them, so the
/// values are always bound. `to_sql` writes the placeholders the dialect wants.
///
/// ```valk
/// let rows = db.select("id, name")
///     .from("users")
///     .where("age > ?", .{ 18 })
///     .where("active = ?", .{ true })
///     .order_by("name")
///     .limit(10)
///     .all() ! panic("%{E.message}")
/// ```
+ class Query {
    kind: uint (QUERY_SELECT)
    db: ?Db (null)
    table: String ("")
    columns: String ("*")
    joins: Array[String] (.{})
    conditions: Conditions (.{})
    assignments: Array[String] (.{})
    insert_columns: Array[String] (.{})
    insert_rows: uint (0)
    groups: String ("")
    havings: Conditions (.{})
    orders: String ("")
    returns: String ("")
    conflict_kind: uint (CONFLICT_NONE)
    conflict_columns: Array[String] (.{})
    conflict_updates: Array[String] (.{})
    row_limit: uint (0)
    row_offset: uint (0)
    // The values, in the order the parts were added
    join_args: Array[Value] (.{})
    set_args: Array[Value] (.{})
    insert_args: Array[Value] (.{})

    /// Starts a `SELECT`.
    + static fn select(columns: String ("*")) Query {
        return Query { kind: QUERY_SELECT, columns: columns }
    }
    /// Starts an `INSERT INTO`.
    + static fn insert_into(table: String) Query {
        return Query { kind: QUERY_INSERT, table: table }
    }
    /// Starts an `UPDATE`.
    + static fn update(table: String) Query {
        return Query { kind: QUERY_UPDATE, table: table }
    }
    /// Starts a `DELETE FROM`.
    + static fn delete_from(table: String) Query {
        return Query { kind: QUERY_DELETE, table: table }
    }

    /// Binds the query to a database, so that it can run itself.
    + fn on(db: Db) SELF {
        this.db = db
        return this
    }

    /// The table to read from.
    + fn from(table: String) SELF {
        this.table = table
        return this
    }

    /// Adds a join, written as it is: `join("LEFT JOIN posts ON posts.user_id = users.id")`.
    + fn join(clause: String, args: Array[Value] (.{})) SELF {
        this.joins.append(clause)
        this.join_args.append_many(args)
        return this
    }

    /// Adds `JOIN <table> ON <condition>`.
    ///
    /// ```valk
    /// query.join_on("posts", "posts.user_id = users.id")
    /// ```
    + fn join_on(table: String, condition: String, args: Array[Value] (.{})) SELF {
        return this.join("JOIN " + table + " ON " + condition, args)
    }
    /// Adds `LEFT JOIN <table> ON <condition>`, which keeps the rows that match nothing.
    + fn left_join(table: String, condition: String, args: Array[Value] (.{})) SELF {
        return this.join("LEFT JOIN " + table + " ON " + condition, args)
    }
    /// Adds `INNER JOIN <table> ON <condition>`.
    + fn inner_join(table: String, condition: String, args: Array[Value] (.{})) SELF {
        return this.join("INNER JOIN " + table + " ON " + condition, args)
    }

    /// Adds a condition with `AND`.
    ///
    /// Each `?` in the condition takes the next value from `args`.
    + fn where(condition: String, args: Array[Value] (.{})) SELF {
        this.conditions.where(condition, args)
        return this
    }

    /// Adds a condition with `OR`.
    ///
    /// ```valk
    /// query.where("role = ?", .{ sql.Value.of("admin") })
    /// query.or_where("score > ?", .{ sql.Value.of_int(100) })
    /// // WHERE (role = ?) OR (score > ?)
    /// ```
    + fn or_where(condition: String, args: Array[Value] (.{})) SELF {
        this.conditions.or_where(condition, args)
        return this
    }

    /// Adds a group of conditions with `AND`, written in brackets, for a query that mixes `AND`
    /// and `OR`.
    ///
    /// ```valk
    /// query.where("active = ?", .{ sql.Value.of_bool(true) })
    /// query.where_group(fn(w: sql.Conditions) {
    ///     w.where("role = ?", .{ sql.Value.of("admin") })
    ///     w.or_where("score > ?", .{ sql.Value.of_int(100) })
    /// })
    /// // WHERE (active = ?) AND ((role = ?) OR (score > ?))
    /// ```
    + fn where_group(build: fn(Conditions)()) SELF {
        this.conditions.group(build)
        return this
    }
    /// Adds a group of conditions with `OR`, written in brackets.
    + fn or_where_group(build: fn(Conditions)()) SELF {
        this.conditions.or_group(build)
        return this
    }

    /// Adds `column IN (?, ?, …)` with one placeholder per value. An empty list matches nothing.
    + fn where_in(column: String, values: Array[Value]) SELF {
        this.conditions.where_in(column, values)
        return this
    }
    /// Adds `column NOT IN (?, ?, …)`. An empty list matches everything.
    + fn where_not_in(column: String, values: Array[Value]) SELF {
        this.conditions.where_not_in(column, values)
        return this
    }

    /// Adds `column IS NULL`.
    + fn where_null(column: String) SELF {
        this.conditions.where_null(column)
        return this
    }
    /// Adds `column IS NOT NULL`.
    + fn where_not_null(column: String) SELF {
        this.conditions.where_not_null(column)
        return this
    }

    /// Sets a column of an `UPDATE`.
    + fn set(column: String, value: Value) SELF {
        this.assignments.append(column + " = ?")
        this.set_args.append(value)
        return this
    }
    /// Sets a column of an `UPDATE` to an expression, such as `balance + ?`.
    + fn set_expression(column: String, expression: String, args: Array[Value] (.{})) SELF {
        this.assignments.append(column + " = " + expression)
        this.set_args.append_many(args)
        return this
    }
    /// Sets several columns of an `UPDATE`.
    + fn set_many(values: Map[Value]) SELF {
        each values as value, column {
            this.set(column, value)
        }
        return this
    }

    /// Adds a row to an `INSERT`. Every row must have the same columns.
    + fn values(row: Map[Value]) SELF {
        if this.insert_rows == 0 {
            each row as value, column {
                this.insert_columns.append(column)
            }
        }
        each this.insert_columns as column {
            this.insert_args.append(row.get(column) !? Value.null())
        }
        this.insert_rows++
        return this
    }

    /// Adds a `GROUP BY`.
    + fn group_by(columns: String) SELF {
        this.groups = columns
        return this
    }
    /// Adds a `HAVING` condition with `AND`.
    + fn having(condition: String, args: Array[Value] (.{})) SELF {
        this.havings.where(condition, args)
        return this
    }
    /// Adds a `HAVING` condition with `OR`.
    + fn or_having(condition: String, args: Array[Value] (.{})) SELF {
        this.havings.or_where(condition, args)
        return this
    }
    /// Adds a group of `HAVING` conditions, written in brackets.
    + fn having_group(build: fn(Conditions)()) SELF {
        this.havings.group(build)
        return this
    }
    /// Adds an `ORDER BY`, written as it is: `order_by("name ASC, id DESC")`.
    + fn order_by(columns: String) SELF {
        this.orders = columns
        return this
    }
    /// Adds a `LIMIT`.
    + fn limit(count: uint) SELF {
        this.row_limit = count
        return this
    }
    /// Adds an `OFFSET`.
    + fn offset(count: uint) SELF {
        this.row_offset = count
        return this
    }

    /// Takes one page of rows: page 1 is the first `per_page` rows, page 2 the next, and so on.
    ///
    /// ```valk
    /// let rows = db.select().from("posts").order_by("id").page(2, 20).all() ! panic("%{E.message}")
    /// ```
    + fn page(number: uint, per_page: uint) SELF {
        let page = number > 0 ? number : 1
        this.row_limit = per_page
        this.row_offset = (page - 1) * per_page
        return this
    }
    /// On a row that clashes with one that is already there, writes the new values over it.
    ///
    /// `columns` are the ones that decide what a clash is, which SQLite and Postgres need (the
    /// columns of the unique index); MySQL finds that out by itself and ignores them.
    /// `update_columns` are the ones to overwrite, and empty means every column of the insert.
    ///
    /// ```valk
    /// db.insert_into("counters")
    ///     .values(.{ "name" => sql.Value.of("visits"), "n" => sql.Value.of_int(1) })
    ///     .on_conflict_update(.{ "name" }, .{ "n" })
    ///     .run() ! panic("%{E.message}")
    /// ```
    + fn on_conflict_update(columns: Array[String], update_columns: Array[String] (.{})) SELF {
        this.conflict_columns = columns
        this.conflict_updates = update_columns
        this.conflict_kind = CONFLICT_UPDATE
        return this
    }

    /// On a row that clashes with one that is already there, keeps the row that is there.
    + fn on_conflict_nothing(columns: Array[String] (.{})) SELF {
        this.conflict_columns = columns
        this.conflict_kind = CONFLICT_NOTHING
        return this
    }

    /// Adds a `RETURNING`, which SQLite and Postgres have and MySQL does not.
    + fn returning(columns: String) SELF {
        this.returns = columns
        return this
    }

    /// Returns the values of the statement, in the order its placeholders take them.
    + fn args() Array[Value] {
        let _, args = this.build(Dialect.sqlite)
        return args
    }

    /// Writes the statement for `dialect`.
    + fn to_sql(dialect: Dialect (Dialect.sqlite)) String {
        let statement, _ = this.build(dialect)
        return statement
    }

    // The statement and its values in one pass, so that a value always sits where its
    // placeholder does, however the conditions are nested
    fn build(dialect: Dialect) (String, Array[Value]) {
        let args: Array[Value] = .{}
        let out = ByteBuffer.new(128)
        let kind = this.kind
        if kind == QUERY_SELECT {
            out.write("SELECT ")
            out.write(this.columns)
            if this.table.length > 0 {
                out.write(" FROM ")
                out.write(this.table)
            }
            each this.joins as clause {
                out.write_byte(' ')
                out.write(clause)
            }
        } else if kind == QUERY_INSERT {
            out.write("INSERT INTO ")
            out.write(this.table)
            out.write(" (")
            each this.insert_columns as column, index {
                if index > 0 : out.write(", ")
                out.write(column)
            }
            out.write(") VALUES ")
            let row: uint = 0
            while row < this.insert_rows {
                if row > 0 : out.write(", ")
                out.write_byte('(')
                out.write(placeholders(this.insert_columns.length))
                out.write_byte(')')
                row++
            }
            if this.conflict_kind != CONFLICT_NONE : this.write_conflict(out, dialect)
        } else if kind == QUERY_UPDATE {
            out.write("UPDATE ")
            out.write(this.table)
            out.write(" SET ")
            each this.assignments as assignment, index {
                if index > 0 : out.write(", ")
                out.write(assignment)
            }
        } else {
            out.write("DELETE FROM ")
            out.write(this.table)
        }

        args.append_many(this.insert_args)
        args.append_many(this.set_args)
        args.append_many(this.join_args)

        if this.conditions.length > 0 {
            out.write(" WHERE ")
            this.conditions.render(out, args)
        }
        if this.groups.length > 0 {
            out.write(" GROUP BY ")
            out.write(this.groups)
        }
        if this.havings.length > 0 {
            out.write(" HAVING ")
            this.havings.render(out, args)
        }
        if this.orders.length > 0 {
            out.write(" ORDER BY ")
            out.write(this.orders)
        }
        if this.row_limit > 0 {
            out.write(" LIMIT ")
            out.write_uint_ascii(this.row_limit)
        }
        if this.row_offset > 0 {
            // Every one of these databases takes OFFSET after LIMIT, and MySQL needs a LIMIT
            // in front of it
            if this.row_limit == 0 && dialect == Dialect.mysql : out.write(" LIMIT 18446744073709551615")
            out.write(" OFFSET ")
            out.write_uint_ascii(this.row_offset)
        }
        if this.returns.length > 0 {
            out.write(" RETURNING ")
            out.write(this.returns)
        }
        return (rewrite(out.to_string(), dialect), args)
    }

    /// Runs the statement and returns how many rows it changed.
    + fn run() uint !Error {
        let db = this.database() !>
        let statement, args = this.build(db.dialect)
        return db.driver.exec(statement, args) !>
    }
    /// Runs the statement and returns every row.
    + fn all() Array[Map[Value]] !Error {
        let db = this.database() !>
        let statement, args = this.build(db.dialect)
        return rows_of(db.driver.query(statement, args) !>) !>
    }
    /// Runs the statement and returns its first row, or null.
    + fn one() ?Map[Value] !Error {
        let db = this.database() !>
        this.limit(1)
        let statement, args = this.build(db.dialect)
        let rows = db.driver.query(statement, args) !>
        let row: Map[Value] = .{}
        let found = rows.next(row) ! { rows.close() throw E }
        rows.close()
        if !found : return null
        return row
    }
    /// Runs the statement and returns the first value of its first row.
    + fn value() Value !Error {
        let row = this.one() !>
        if !isset(row) : return Value.null()
        each row as value : return value
        return Value.null()
    }

    /// Runs the same query as a count, without its order, limit and offset.
    ///
    /// This is the count that belongs next to a page of rows: the table, the joins and the
    /// conditions are the ones of this query.
    + fn count(expression: String ("*")) uint !Error {
        let db = this.database() !>
        let columns = this.columns
        let limit = this.row_limit
        let offset = this.row_offset
        let orders = this.orders
        this.columns = "count(" + expression + ") AS n"
        this.row_limit = 0
        this.row_offset = 0
        this.orders = ""
        let statement, args = this.build(db.dialect)
        this.columns = columns
        this.row_limit = limit
        this.row_offset = offset
        this.orders = orders

        let rows = db.driver.query(statement, args) !>
        let row: Map[Value] = .{}
        let found = rows.next(row) ! { rows.close() throw E }
        rows.close()
        if !found : return 0
        each row as value : return value.to_uint()
        return 0
    }

    // `ON CONFLICT` for SQLite and Postgres, `ON DUPLICATE KEY` for MySQL
    fn write_conflict(out: ByteBuffer, dialect: Dialect) {
        let updates = this.conflict_updates.length > 0 ? this.conflict_updates : this.insert_columns

        if dialect == Dialect.mysql {
            if this.conflict_kind == CONFLICT_NOTHING {
                // MySQL has no "do nothing"; writing a column to itself is how it is done
                let column = this.insert_columns.get(0) !? ""
                out.write(" ON DUPLICATE KEY UPDATE ")
                out.write(column)
                out.write(" = ")
                out.write(column)
                return
            }
            out.write(" ON DUPLICATE KEY UPDATE ")
            each updates as column, index {
                if index > 0 : out.write(", ")
                out.write(column)
                out.write(" = VALUES(")
                out.write(column)
                out.write_byte(')')
            }
            return
        }

        out.write(" ON CONFLICT")
        if this.conflict_columns.length > 0 {
            out.write(" (")
            each this.conflict_columns as column, index {
                if index > 0 : out.write(", ")
                out.write(column)
            }
            out.write_byte(')')
        }
        if this.conflict_kind == CONFLICT_NOTHING {
            out.write(" DO NOTHING")
            return
        }
        out.write(" DO UPDATE SET ")
        each updates as column, index {
            if index > 0 : out.write(", ")
            out.write(column)
            out.write(" = excluded.")
            out.write(column)
        }
    }

    fn database() Db !Error {
        let db = this.db
        if !isset(db) : throw .error { message: "This query is not bound to a database; use db.select(...) or query.on(db)", sql: this.to_sql() }
        return db
    }
}

// Reads every row of a result and closes it
fn rows_of(rows: Rows) Array[Map[Value]] !Error {
    let out: Array[Map[Value]] = .{}
    while true {
        let row: Map[Value] = .{}
        if !(rows.next(row) ! { rows.close() throw E }) : break
        out.append(row)
    }
    rows.close()
    return out
}

/// Returns `?, ?, ?` for `count` values, to write an `IN (...)` list by hand.
+ fn placeholders(count: uint) String {
    if count == 0 : return ""
    let out = ByteBuffer.new(count * 3)
    let i: uint = 0
    while i++ < count {
        if i > 1 : out.write(", ")
        out.write_byte('?')
    }
    return out.to_string()
}
