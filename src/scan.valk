@ignore_access

use valk.json

/// Reads a row into a class or struct of your own.
///
/// Every field of `T` must be a column of the row, unless the field is nullable, has a default, or
/// is marked `$tag(sql: "-")`. Field tags control column matching:
/// - `$tag(sql: "col_name")` matches column `col_name` instead of the field name.
/// - `$tag(sql: "-")` skips the field and uses its default value.
/// - `$tag(omitempty)` allows missing or `NULL` columns when the field has a default.
///
/// `sql` tags are independent of `json` tags: if no `sql` tag is present, the field name is used.
///
/// Boolean fields accept Postgres booleans as well as SQLite/MySQL `0` and `1` integers directly.
/// Pass `bool_columns` if a column holds text booleans (such as `"true"` or `"yes"`) or other
/// non-zero integers.
///
/// Types with `from_json_value` / `from_json_value_auto` (such as `Uuid`, `Ulid`, `Decimal`) and
/// nested JSON columns (`json.Value`, arrays, maps, nested classes/structs stored as JSON text)
/// are decoded automatically.
///
/// ```valk
/// class User {
///     id: uint
///     full_name: String $tag(sql: "full_name")
///     nickname: ?String
///     cached: String ("") $tag(sql: "-")
/// }
///
/// let row = db.one("SELECT * FROM users WHERE id = :id", .{ "id" => 1 }) ! panic("%{E.message}")
/// if isset(row) {
///     let user = sql.row_to[User](row) ! panic("%{E.message}")
///     println(user.full_name)
/// }
/// ```
+ fn row_to[T](row: Map[Value], bool_columns: ?Array[String] (null)) T !Error {
    return row_to_inner[T](row, bool_columns) ! {
        throw .error("This row does not fit the type it was read into; its columns were: " + column_names(row), "", "")
    }
}

/// Reads every row into a class or struct of your own, as `row_to` does for one.
+ fn rows_to[T](rows: Array[Map[Value]], bool_columns: ?Array[String] (null)) Array[T] !Error {
    let out = Array[T].new(rows.length)
    each rows as row {
        out.append(row_to[T](row, bool_columns) !>)
    }
    return out
}

/// Converts a class or struct's fields into a `Map[Value]` for `insert_into(...).values(...)` or
/// `update(...).set_many(...)`.
///
/// Field tags control column mapping:
/// - `$tag(sql: "col_name")` writes the field under `col_name` instead of the field name.
/// - `$tag(sql: "-")` omits the field.
/// - `$tag(omitempty)` omits the field when it is `null`, `0`, `false`, `""`, or nil.
///
/// ```valk
/// db.insert_into("users").values(sql.values_of(user)).run() ! panic("%{E.message}")
/// ```
+ fn values_of[T](record: T) Map[Value] {
    #if !T.$nonnull.$is_structural
    #error "values_of requires a class or struct type"
    #else
    let out: Map[Value] = .{}
    #if T.$is_nullable
    if !isset(record) : return out
    #end
    #loop object record as prop
    #if prop.$tag("sql") != "-"
    #if prop.$has_tag("omitempty")
    if !sql_is_empty(prop) {
        out.set(prop.$tag("sql", prop.name), field_to_sql_value(prop))
    }
    #else
    out.set(prop.$tag("sql", prop.name), field_to_sql_value(prop))
    #end
    #end
    #end
    return out
    #end
}

/// Returns the row as a JSON object, for an answer that goes straight out as JSON.
+ fn row_to_json_value(row: Map[Value], bool_columns: ?Array[String] (null)) json.Value {
    let document: json.Value = json.new_object(row_to_json(row, bool_columns))
    return document
}

fn row_to_inner[T](row: Map[Value], bool_columns: ?Array[String]) T !LookupError {
    #if !T.$nonnull.$is_structural
    #error "row_to requires a class or struct type"
    #else
    let result = T.$nonnull {
        #loop properties T as prop
        prop: <{
            #if prop.$tag("sql") == "-"
            #if prop.$has_default_value
            return prop.$default_value
            #else
            #error "Skipped SQL property has no default value"
            #end
            #elif prop.$has_explicit_default_value || prop.$type.$is_nullable || (prop.$has_tag("omitempty") && prop.$has_default_value)
            let col_name = prop.$tag("sql", prop.name)
            let cell = row.get(col_name) ! return prop.$default_value
            if cell.is_null() : return prop.$default_value
            return sql_value_to[prop](cell, col_name, bool_columns) !>
            #else
            let col_name = prop.$tag("sql", prop.name)
            let cell = row.get(col_name) ! throw .missing
            return sql_value_to[prop](cell, col_name, bool_columns) !>
            #end
        }
        #end
    }
    return result
    #end
}

fn sql_value_to[FT](cell: Value, col_name: String, bool_columns: ?Array[String]) FT !LookupError {
    #if FT.$is_nullable
    if cell.is_null() : return null
    #end

    #if FT.$nonnull.$is_type_of(Value)
    return cell
    #elif FT.$nonnull.$is_type_of(json.Value)
    if cell.type == TYPE.text || cell.type == TYPE.blob {
        return json.decode(cell.text) ! return json.new_string(cell.text)
    }
    return value_to_json(cell)
    #else
    if cell.is_null() : throw .missing

    #if FT.$nonnull.$is_bool
    if cell.type == TYPE.bool : return cell.bool_value
    if cell.type == TYPE.int && (cell.int_value == 0 || cell.int_value == 1) : return cell.int_value != 0
    if isset(bool_columns) && bool_columns.contains(col_name) : return cell.to_bool()
    throw .missing
    #elif FT.$nonnull.$is_type_of(String)
    if cell.type != TYPE.text && cell.type != TYPE.blob : throw .missing
    return cell.text
    #elif FT.$nonnull.$has_method(from_json_value) || FT.$nonnull.$has_method(from_json_value_auto)
    let direct = value_to_json(cell).to_type[FT.$nonnull]() ! {
        if cell.type == TYPE.text || cell.type == TYPE.blob {
            let decoded = json.decode(cell.text) ! throw .missing
            if !decoded.is_string : return decoded.to_type[FT.$nonnull]() !>
        }
        throw .missing
    }
    return direct
    #elif FT.$nonnull.$is_structural
    if cell.type == TYPE.text || cell.type == TYPE.blob {
        let decoded = json.decode(cell.text) ! throw .missing
        return decoded.to_type[FT.$nonnull]() !>
    }
    throw .missing
    #else
    return value_to_json(cell).to_type[FT.$nonnull]() !>
    #end
    #end
}

fn field_to_sql_value(ndata: $T) Value {
    #if T.$is_nullable
    if !isset(ndata) : return Value.null()
    #end

    let data = ndata

    #if T.$nonnull.$is_type_of(Value)
    return data
    #elif T.$nonnull.$is_type_of(String)
    return Value.of(data)
    #elif T.$nonnull.$is_type_of(json.Value)
    return Value.of(data.encode())
    #elif T.$nonnull.$is_bool
    return Value.of_bool(data)
    #elif T.$nonnull.$is_integer
    return Value.of_int(data.to(int))
    #elif T.$nonnull.$is_float
    return Value.of_float(data.to(float))
    #elif T.$nonnull.$has_method(to_json_string)
    return Value.of(data.to_json_string())
    #elif T.$nonnull.$has_method(write_json_auto)
    return Value.of(json.encode(data))
    #elif T.$nonnull.$has_method(to_sql_value)
    return data.to_sql_value()
    #elif T.$nonnull.$can_convert_to(Value)
    return data.to(Value)
    #elif T.$nonnull.$is_structural
    return Value.of(json.encode(data))
    #else
    #error "Cannot convert this field to a sql Value"
    #end
}

fn sql_is_empty(data: $T) bool {
    if !isset(data) : return true

    #if T.$nonnull.$is_type_of(Value)
    return data.is_null()
    #elif T.$nonnull.$is_type_of(json.Value)
    if data.is_null : return true
    if data.is_string : return data.string.bytes == 0
    if data.is_array : return data.array.length == 0
    if data.is_object : return data.object.length == 0
    if data.is_bool : return !data.bool
    if data.is_int : return data.int == 0
    if data.is_float : return data.float == 0.0
    return false
    #elif T.$nonnull.$is_type_of(String)
    return data.bytes == 0
    #elif T.$nonnull.$has_method(is_nil)
    return data.is_nil()
    #elif T.$nonnull.$has_method(is_json_empty)
    return data.is_json_empty()
    #elif T.$nonnull.$is_bool
    return !data
    #elif T.$nonnull.$is_integer
    #if T.$is_signed
    return data.to(int) == 0
    #else
    return data.to(uint) == 0
    #end
    #elif T.$nonnull.$is_float
    return data == 0.0
    #else
    return false
    #end
}

fn column_names(row: Map[Value]) String {
    let names: Array[String] = .{}
    each row as value, column {
        names.append(column)
    }
    return names.join(", ")
}

fn row_to_json(row: Map[Value], bool_columns: ?Array[String]) Map[json.Value] {
    let values: Map[json.Value] = .{}
    each row as value, column {
        if isset(bool_columns) && bool_columns.contains(column) {
            values.set(column, json.new_bool(value.to_bool()))
            continue
        }
        values.set(column, value_to_json(value))
    }
    return values
}

fn value_to_json(value: Value) json.Value {
    let type = value.type
    if type == TYPE.null : return json.new_null()
    if type == TYPE.bool : return json.new_bool(value.bool_value)
    if type == TYPE.int : return json.new_int(value.int_value)
    if type == TYPE.float : return json.new_float(value.float_value)
    return json.new_string(value.text)
}
